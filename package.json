{
  "name": "react-native-gym-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --experimental-sqlite --test",
    "check:expo": "expo install --check",
    "validate": "npm run typecheck && npm run test && npm run check:expo",
    "check:release-config": "node scripts/check-release.mjs --config",
    "check:release-ready": "node scripts/check-release.mjs --ready",
    "check:native-config": "node scripts/check-native-config.mjs",
    "check:eas-linked": "node scripts/check-release.mjs --linked"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.30",
    "expo-router": "~57.0.28",
    "expo-status-bar": "~57.0.1",
    "react": "19.3.0",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "expo-sqlite": "~57.0.1",
    "expo-file-system": "~57.0.7",
    "expo-document-picker": "~57.0.3",
    "expo-sharing": "~57.0.19"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  }
}
