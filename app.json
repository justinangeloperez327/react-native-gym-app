{
  "expo": {
    "name": "Gym App",
    "slug": "react-native-gym-app",
    "description": "Offline-first training, nutrition, and wellbeing tracking.",
    "scheme": "gymapp",
    "version": "0.1.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.justinangeloperez.gymapp"
    },
    "android": {
      "package": "com.justinangeloperez.gymapp",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router"
    ]
  }
}
